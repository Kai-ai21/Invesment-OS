GEMINI_API_KEY=
SEC_USER_AGENT=
CHROMA_PATH=

# --- database ---------------------------------------------------------------------

# Where the application database lives. LEAVE THIS BLANK FOR LOCAL DEVELOPMENT: unset
# (or empty) falls back to the SQLite file at investment_os.db in the repo root, which
# is exactly what this project used before Postgres was an option. Nothing about
# running locally changes by ignoring this variable.
#
# Set it in deployment, where a container-local SQLite file would be erased on every
# restart. Format:
#     postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
#
# ⚠️ TWO REWRITES HAPPEN AUTOMATICALLY, so a URL pasted from a managed host works as
# given — you do not have to hand-edit it:
#   - "postgres://..."    SQLAlchemy dropped this alias in 1.4 and cannot open it.
#                         Heroku, Railway, Render and Fly still hand it out.
#   - "postgresql://..."  Valid, but SQLAlchemy defaults it to the psycopg2 driver,
#                         which this project does not install (it uses psycopg 3).
# Both are normalised to "postgresql+psycopg://" by normalise_database_url() in
# backend/models/database.py. An explicitly named driver is never overridden.
#
# Managed Postgres usually requires TLS; keep the "?sslmode=require" your provider
# appends, it survives the rewrite.
#
# ⚠️ THIS STRING CONTAINS THE DATABASE PASSWORD. Treat it like JWT_SECRET below —
# never commit a filled-in value.
#
# Moving existing SQLite data across is a separate, one-off step:
#     python -m scripts.migrate_to_postgres
DATABASE_URL=

# --- CORS ---------------------------------------------------------------------------

# Which browser origins may call this API, comma-separated. LEAVE BLANK FOR LOCAL
# DEVELOPMENT: unset falls back to the Vite dev server on both spellings of localhost,
#     http://localhost:5173,http://127.0.0.1:5173
# which is exactly the list that used to be hardcoded in backend/main.py.
#
# Set it in deployment to wherever the frontend is actually served from, e.g.
#     CORS_ORIGINS=https://investment-os.example.com
#     CORS_ORIGINS=https://app.example.com,https://staging.example.com
#
# An origin is SCHEME + HOST + PORT and nothing else. No path, and no trailing slash —
# a browser never sends one, so "https://app.example.com/" would match no request at
# all. Trailing slashes are stripped for you, spaces after commas are fine.
#
# ⚠️ "*" IS REFUSED AND THE APP WILL NOT START WITH IT. This API sends credentials, and
# a wildcard combined with that makes Starlette echo back whatever origin asked —
# allowing every site on the internet rather than opening a public read-only API. List
# the origins you actually want. See cors_origins() in backend/main.py.
CORS_ORIGINS=

# Passages retrieved per claim before verification. Defaults to 8 if unset.
# Higher = fewer silent misses (the decisive passage is more likely to reach the
# model) but more tokens per claim; roughly k x 800 characters. Lower saves tokens
# but risks the model never seeing the evidence and returning a confident "neutral"
# — a failure with no visible symptom, which is why the default errs on the high side.
# 8 was measured with hybrid retrieval against an NVDA 10-K, where the best relevant
# passage ranked #1, #0 and #1 across the three claims (one filing, three claims).
RETRIEVAL_K=

# --- auth -------------------------------------------------------------------------

# ⚠️ MASTER KEY. This signs every access token the app issues, so anyone holding it
# can mint a valid token for ANY user id — it is equivalent to the password of every
# account at once. Never commit it, never share it, and use a different value in
# every environment.
#
# Must be a long random string; the app REFUSES TO START if it is missing or shorter
# than 32 characters, rather than falling back to a default (a default would be a
# published master key). Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it immediately invalidates every token already issued, which is the
# intended lever if you ever think one has leaked: rotate, and everyone signs in again.
JWT_SECRET=

# How long an access token stays valid, in minutes. Defaults to 1440 (24 hours) if
# unset. There is no refresh-token flow yet, so this is also how often a user has to
# sign in again — shorter is safer, and shortens the window in which a stolen token
# is useful, at the cost of more logins.
ACCESS_TOKEN_EXPIRE_MINUTES=

# Whether POST /auth/signup accepts new accounts. Defaults to "true" when unset.
# Set to "false" once your own account exists to close public registration — the
# endpoint then answers 403. Anything not recognisably true ("1", "true", "yes",
# "on") counts as false, so a typo closes signups rather than opening them.
ALLOW_SIGNUP=

# NOTE: AUTH_REQUIRED was an A2-only transitional flag and no longer exists. A3
# removed it along with the anonymous fallback — authentication is unconditional, so
# there is no setting that turns it off. Delete this variable from your .env if you
# set it; it is now ignored.
