GEMINI_API_KEY=
SEC_USER_AGENT=
CHROMA_PATH=

# Passages retrieved per claim before verification. Defaults to 8 if unset.
# Higher = fewer silent misses (the decisive passage is more likely to reach the
# model) but more tokens per claim; roughly k x 800 characters. Lower saves tokens
# but risks the model never seeing the evidence and returning a confident "neutral"
# — a failure with no visible symptom, which is why the default errs on the high side.
# 8 was measured with hybrid retrieval against an NVDA 10-K, where the best relevant
# passage ranked #1, #0 and #1 across the three claims (one filing, three claims).
RETRIEVAL_K=

# --- auth -------------------------------------------------------------------------

# ⚠️ MASTER KEY. This signs every access token the app issues, so anyone holding it
# can mint a valid token for ANY user id — it is equivalent to the password of every
# account at once. Never commit it, never share it, and use a different value in
# every environment.
#
# Must be a long random string; the app REFUSES TO START if it is missing or shorter
# than 32 characters, rather than falling back to a default (a default would be a
# published master key). Generate one with:
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# Changing it immediately invalidates every token already issued, which is the
# intended lever if you ever think one has leaked: rotate, and everyone signs in again.
JWT_SECRET=

# How long an access token stays valid, in minutes. Defaults to 1440 (24 hours) if
# unset. There is no refresh-token flow yet, so this is also how often a user has to
# sign in again — shorter is safer, and shortens the window in which a stolen token
# is useful, at the cost of more logins.
ACCESS_TOKEN_EXPIRE_MINUTES=

# Whether POST /auth/signup accepts new accounts. Defaults to "true" when unset.
# Set to "false" once your own account exists to close public registration — the
# endpoint then answers 403. Anything not recognisably true ("1", "true", "yes",
# "on") counts as false, so a typo closes signups rather than opening them.
ALLOW_SIGNUP=
